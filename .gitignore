# CTF Repository .gitignore

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-project
*.sublime-workspace

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
venv/
env/
ENV/

# Node.js
node_modules/
npm-debug.log
yarn-error.log
package-lock.json

# Compiled binaries and object files
*.o
*.a
*.out
*.exe
*.dll
*.so
*.dylib
a.out
core

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.backup

# Environment variables
.env
.env.local

# Docker
.dockerignore

# Sensitive information (just in case)
*password*
*secret*
*key.txt
*.pem
*.key
credentials.txt
flags.txt

# CTF-specific (if needed)
# Uncomment if you want to exclude certain challenge files
# */flag.txt
# */solution.py
